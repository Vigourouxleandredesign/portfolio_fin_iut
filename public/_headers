/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; connect-src 'self' blob:; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; worker-src 'self' blob:; frame-src 'self' https://visualcom.nc https://magicallab.netlify.app https://leandredatavizchallenge.figma.site; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static files outside /assets (not content-hashed): short caches instead of revalidating on every visit.
# Nothing here touches /jury* (private, no-store) or /documents/*.
/draco/*
  Cache-Control: public, max-age=604800

/og/*
  Cache-Control: public, max-age=86400

/og-cover.jpg
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/logo-leandre.svg
  Cache-Control: public, max-age=86400
