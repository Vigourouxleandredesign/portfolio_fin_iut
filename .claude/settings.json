{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/guard-git-bypass.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking for git hook bypass"
          }
        ]
      }
    ]
  }
}
