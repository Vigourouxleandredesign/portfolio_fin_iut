{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tooling.json",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate": "npm run typecheck && npm run check:secrets && npm run test && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test",
    "gate:full": "npm run gate && npm run test:e2e",
    "audit:ci": "npm audit --audit-level=high && npm audit signatures",
    "audit:prod": "npm audit --omit=dev",
    "shots": "node scripts/capture-project-shots.mjs",
    "decor:paint": "python scripts/generate-paint-decor.py",
    "format": "prettier --write .",
    "typography": "node scripts/fix-french-typography.mjs",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"src/**/*.css\"",
    "fix": "prettier --write . && eslint . --fix && stylelint \"src/**/*.css\" --fix",
    "ci:static": "npm run format:check && npm run lint && npm run lint:css",
    "ci": "npm run audit:ci && npm run ci:static && npm run gate && npm run test:e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@fontsource/ubuntu": "^5.3.0",
    "@fontsource/ubuntu-mono": "^5.3.0",
    "@fontsource/updock": "^5.3.0",
    "three": "0.185.1",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.49.1",
    "@tweakpane/core": "^2.0.5",
    "@types/node": "22.20.5",
    "@types/three": "^0.185.3",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "happy-dom": "^21.0.4",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "8.72.0",
    "vite": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
